# Optional. The SEC asks automated clients to identify themselves with a
# descriptive User-Agent that includes contact info. If unset, a generic default
# is used. Example: SEC_USER_AGENT="Your Name Research yourname@yourdomain.com"
SEC_USER_AGENT=

# Optional test hook: make sources fail to see the error states, e.g. "all" or "sec,yahoo,news".
SIMULATE_OUTAGE=
